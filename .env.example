# Copy to .env and fill in. See README.md "Configuration" for details.

# Postgres (Supabase pooler, port 6543)
DATABASE_URL=

# Clerk (sign-in) - https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PayPal sandbox REST app - https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=

# Daily job (deadline refunds, scheduled payouts): any long random string
CRON_SECRET=

# Amazon Bedrock (AI). Use an API key, or leave blank to use the local AWS credential chain.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional: receipt and invite emails
RESEND_API_KEY=
RESEND_FROM=
