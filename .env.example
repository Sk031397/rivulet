# Rivulet environment configuration
# Copy this file to .env and fill in real values.
# Leave credentials blank to run in MOCK mode (no real AI and no real PayPal calls).

# PayPal (sandbox or production)
# Public copy of the client ID for the PayPal JS SDK on the /pay page (client IDs are safe to expose).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Server port for `next dev` / `next start`
PORT=3001

# AWS — drives the AI flow builder (Amazon Bedrock / Nova) via the Node
# credential provider chain. If blank, credentials are read from the environment
# or ~/.aws/credentials, so you only need these for explicit config.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
